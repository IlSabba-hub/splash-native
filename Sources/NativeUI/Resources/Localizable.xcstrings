      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without --max-memory every Splash server takes a Metal budget: the GPU's working set less a margin. Two servers each count the whole budget: set a limit on the second."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza --max-memory ogni server di Splash si dà un budget Metal: working set della GPU meno un margine. Due server contano ciascuno tutto il budget: dai un limite al secondo."
          }
        }
      }
    },
