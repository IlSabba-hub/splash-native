    "versions.upgrade.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew installs the newest Splash of the tap and keeps the models; the previous keg follows Homebrew's cleanup. Running servers stay on the old version until you reload them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew installa lo Splash più recente del tap e conserva i modelli; il keg precedente segue il cleanup di Homebrew. I server attivi restano sulla versione di prima finché non li ricarichi."
          }
        }
      }
    },
