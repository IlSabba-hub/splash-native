            "state": "translated",
            "value": "Shows the flag and the source"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il flag e la fonte"
          }
        }
      }
    },
    "a11y.status": {
      "extractionState": "manual",
