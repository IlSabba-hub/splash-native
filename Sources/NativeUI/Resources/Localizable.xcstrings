{
  "sourceLanguage": "en",
  "strings": {
    "a11y.codeBlock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code block %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocco di codice %@"
          }
        }
      }
    },
