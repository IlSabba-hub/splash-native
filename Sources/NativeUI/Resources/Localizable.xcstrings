    "storage.experts.about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Splash keeps the experts in memory where they fit, else reads the missing ones from the SSD (slower). “Limit” fixes their RAM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In automatico Splash tiene gli esperti in memoria se ci stanno, se no legge dall'SSD quelli che mancano (più lento). «Limite» ne fissa la RAM."
          }
        }
      }
    },
