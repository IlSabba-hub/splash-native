          "stringUnit": {
            "state": "translated",
            "value": "latest %1$@, lowest %2$@, highest %3$@, gaps: %4$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ultimo %1$@, minimo %2$@, massimo %3$@, buchi: %4$@"
