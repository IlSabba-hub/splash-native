            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "a11y.table": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Table, %1$@ columns, %2$@ rows"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabella, %1$@ colonne, %2$@ righe"
          }
        }
      }
    },
    "a11y.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile: %@"
          }
        }
      }
    },
    "a11y.updateAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update available"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento disponibile"
          }
        }
      }
    },
    "about.activations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "auto rounds activations to 8 bits where the GPU multiplies them twice as fast (M5 and later); bf16 keeps them all bf16."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "auto arrotonda le attivazioni a 8 bit dove la GPU le moltiplica il doppio più in fretta (M5 e successivi); bf16 le tiene tutte bf16."
          }
        }
      }
    },
    "about.allow-idle-sleep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the Mac sleep on its own while requests run."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che il Mac vada in stop da solo mentre le richieste girano."
          }
        }
      }
    },
    "about.allowed-host": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Host name to accept, such as mymac.local; it does not change the listening address."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro nome Host da accettare, come mymac.local; non cambia l'indirizzo d'ascolto."
          }
        }
      }
    },
    "about.allowed-origin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An origin whose pages may call the API from a browser or a webview; “*” for any."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'origine le cui pagine possono chiamare l'API da un browser o una webview; «*» per tutte."
          }
        }
      }
    },
    "about.announce-served-name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Responses and /v1/models use the first extra name; /status keeps the model ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte e /v1/models usano il primo nome in più; /status tiene l'ID del modello."
          }
        }
      }
    },
    "about.api-key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key required on every route but the chat page, /health and /ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave richiesta su ogni rotta tranne la pagina della chat, /health e /ready."
          }
        }
      }
    },
    "about.cache-dir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the persistent cache keeps its files."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove la cache persistente tiene i suoi file."
          }
        }
      }
    },
    "about.cached-states": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cached states: int8 takes about a quarter but a restore can differ at near ties; exact restores them exactly."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stati in cache: int8 ne occupa circa un quarto ma un ripristino può differire di poco; exact li ripristina identici."
          }
        }
      }
    },
    "about.chat-template-file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Jinja chat template for every request instead of the model's own, read at startup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un template Jinja per tutte le richieste al posto di quello del modello, letto all'avvio."
          }
        }
      }
    },
    "about.decode-share": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The decode time owed per unit of prefill time while other requests decode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di decode dovuto per ogni unità di tempo di prefill mentre altre richieste fanno decode."
          }
        }
      }
    },
    "about.default-reasoning-effort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reasoning effort of the requests that set none."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sforzo di ragionamento delle richieste che non ne chiedono uno."
          }
        }
      }
    },
    "about.disable-ane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs prefill on the GPU alone, without the Neural Engine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa il prefill solo sulla GPU, senza il Neural Engine."
          }
        }
      }
    },
    "about.draft-model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DFlash2 draft proposes tokens and the model verifies them, so decode speeds up. Pick one here instead of the automatic one."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza DFlash2 propone i token e il modello li verifica: il decode accelera. Qui si sceglie al posto di quella automatica."
          }
        }
      }
    },
    "about.expert-memory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MoE only: the RAM for the routed experts. Those that do not fit are read from the SSD when a token routes them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo MoE: la RAM degli esperti instradati. Quelli che non ci stanno si leggono dall'SSD quando un token li chiede."
          }
        }
      }
    },
    "about.field.frequency-penalty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Penalizes tokens by how many times they already appeared, against repetitions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Penalizza i token in proporzione a quante volte sono già apparsi, contro le ripetizioni."
          }
        }
      }
    },
    "about.field.max-tokens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most tokens the answer generates."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti token al più genera la risposta."
          }
        }
      }
    },
    "about.field.min-p": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops the tokens whose probability is below this share of the most likely token's."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarta i token con una probabilità sotto questa quota di quella del token più probabile."
          }
        }
      }
    },
    "about.field.presence-penalty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Penalizes tokens that already appeared, to push toward new topics."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Penalizza i token già apparsi, per spingere verso argomenti nuovi."
          }
        }
      }
    },
    "about.field.reasoning-effort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much the model reasons before answering, where its family allows it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ragiona il modello prima di rispondere, dove la famiglia lo permette."
          }
        }
      }
    },
    "about.field.repetition-penalty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowers the tokens already seen by this factor; above 1 it discourages repetitions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa i token già visti di questo fattore; sopra 1 scoraggia le ripetizioni."
          }
        }
      }
    },
    "about.field.seed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sampling seed: with the same seed and the same parameters the answer repeats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seme del campionamento: con lo stesso seme e gli stessi parametri la risposta si ripete."
          }
        }
      }
    },
    "about.field.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Texts that stop generation when they appear."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi che fermano la generazione quando compaiono."
          }
        }
      }
    },
    "about.field.temperature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How random the choice of the next token is: 0 always takes the most likely one, higher values give more varied answers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto è casuale la scelta del prossimo token: 0 prende sempre il più probabile, valori più alti danno risposte più varie."
          }
        }
      }
    },
    "about.field.thinking-token-budget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most reasoning tokens of this request; then its reasoning closes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti token di ragionamento al più per questa richiesta; poi il ragionamento si chiude."
          }
        }
      }
    },
    "about.field.top-k": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks only among the K most likely tokens; 0 or -1 turn it off."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie solo fra i K token più probabili; 0 o -1 lo spengono."
          }
        }
      }
    },
    "about.field.top-p": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks only among the most likely tokens whose probabilities add up to this value."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie solo fra i token più probabili la cui probabilità sommata arriva a questo valore."
          }
        }
      }
    },
    "about.gpu-wired-limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS's limit on the memory the GPU may wire: it sets the Metal budget Splash plans with."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite di macOS alla memoria che la GPU può vincolare: da qui viene il budget Metal con cui Splash fa i conti."
          }
        }
      }
    },
    "about.host": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listening address: 127.0.0.1 this Mac only, 0.0.0.0 every IPv4 interface, unix:PATH a UNIX socket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo d'ascolto: 127.0.0.1 solo questo Mac, 0.0.0.0 tutte le interfacce IPv4, unix:PERCORSO un socket UNIX."
          }
        }
      }
    },
    "about.idle-release": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After how long without requests the engine frees its memory and the weights; off keeps both."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo quanto tempo senza richieste il motore libera la memoria e i pesi; off li tiene."
          }
        }
      }
    },
    "about.kv-format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the context's KV cache is stored: bf16 uses more memory than int8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si salva la cache KV del contesto: bf16 usa più memoria di int8."
          }
        }
      }
    },
    "about.language-only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips vision: it is neither prepared nor loaded, and images and PDFs are refused."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta la visione: non la prepara né la carica, e immagini e PDF vengono rifiutati."
          }
        }
      }
    },
    "about.max-cache-disk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSD space for cached KV pages and states; 0 turns it off."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio sull'SSD per la cache delle pagine KV e degli stati; 0 la spegne."
          }
        }
      }
    },
    "about.max-cache-disk-writes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most the SSD cache writes a day; 0 sets no limit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto la cache SSD può scrivere al giorno; 0 nessun limite."
          }
        }
      }
    },
    "about.max-concurrent-requests": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many requests the engine runs at once, 1 to 8: more clients answered together, each a little slower, with more memory."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante richieste il motore esegue insieme, da 1 a 8: più client serviti insieme, ognuno un po' più lento e con più memoria."
          }
        }
      }
    },
    "about.max-context": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most tokens the context holds, up to the model's limit. Past the native window a model with YaRN turns it on, which changes answers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti token al più tiene il contesto, fino al limite del modello. Oltre la finestra nativa un modello con YaRN lo accende, e le risposte cambiano."
          }
        }
      }
    },
    "about.max-image-pixels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most pixels of a resized image; it bounds the vision scratch one image needs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pixel massimi di un'immagine ridimensionata; limita la memoria della visione per un'immagine."
          }
        }
      }
    },
    "about.max-memory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Metal memory budget instead of the automatic one, at most the GPU's recommended working set less a margin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget di memoria Metal al posto di quello automatico, al più il working set consigliato della GPU meno un margine."
          }
        }
      }
    },
    "about.max-request-size": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest body of an HTTP request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo più grande di una richiesta HTTP."
          }
        }
      }
    },
    "about.mmproj": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vision projector, a GGUF on this Mac: with it the model reads images and PDFs. Only with a local model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proiettore della visione, un GGUF su questo Mac: con lui il modello legge immagini e PDF. Solo con un modello locale."
          }
        }
      }
    },
    "about.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hugging Face model to serve, with the GGUF variant after “:”. With a model on this Mac it is the ID the API reports."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di Hugging Face da servire, con la variante GGUF dopo «:». Con un modello su questo Mac è l'ID che l'API riporta."
          }
        }
      }
    },
    "about.model-dir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A GGUF file or a GGUF or MLX folder on this Mac, prepared without the Hub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file GGUF o una cartella GGUF o MLX su questo Mac, preparato senza l'Hub."
          }
        }
      }
    },
    "about.no-webui": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns off the chat page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spegne la pagina della chat."
          }
        }
      }
    },
    "about.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the installed model without contacting the Hugging Face Hub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il modello installato senza contattare l'Hub di Hugging Face."
          }
        }
      }
    },
    "about.persistent-cache": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the SSD cache across restarts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene la cache SSD da un avvio all'altro."
          }
        }
      }
    },
    "about.ple-memory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flash-Next only: the RAM cache of the PLE table's rows, the rest streams from the SSD. off loads the whole table, tens of GB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Flash-Next: la cache in RAM delle righe della tabella PLE, il resto si legge dall'SSD. off la carica intera, decine di GB."
          }
        }
      }
    },
    "about.port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's HTTP port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta HTTP del server."
          }
        }
      }
    },
    "about.queue-size": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many requests are admitted at once, running or waiting; more get 503."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante richieste il server ammette insieme, in corso o in attesa; oltre risponde 503."
          }
        }
      }
    },
    "about.reasoning-effort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reasoning effort of every request, whatever it asks; none turns thinking off."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sforzo di ragionamento di ogni richiesta, qualunque cosa chieda; none spegne il ragionamento."
          }
        }
      }
    },
    "about.recalibrate-ane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures again at this start the share of long prompts for the Neural Engine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimisura a questo avvio la quota dei prompt lunghi da dare al Neural Engine."
          }
        }
      }
    },
    "about.request-timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After how long a queued or running request expires with 504."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo quanto tempo una richiesta in coda o in corso scade con 504."
          }
        }
      }
    },
    "about.revision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The branch, tag or commit of the model to use."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ramo, il tag o il commit del modello da usare."
          }
        }
      }
    },
    "about.sampling-default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sampling parameter's value for the requests that set none."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore di un parametro di campionamento per le richieste che non lo impostano."
          }
        }
      }
    },
    "about.served-model-name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An extra API name clients may ask for this model by."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome in più con cui i client chiedono questo modello all'API."
          }
        }
      }
    },
    "about.sparse-kv-memory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flash-Next only: the RAM cache of the KV blocks read for requests whose KV is on the SSD; never below its floor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Flash-Next: la cache in RAM dei blocchi di KV letti per le richieste con la KV sull'SSD; mai sotto il suo minimo."
          }
        }
      }
    },
    "about.state-format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recurrent state of running requests: fp32, or bf16, which halves it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato ricorrente delle richieste in corso: fp32, o bf16 che lo dimezza."
          }
        }
      }
    },
    "about.thinking-end-text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text that ends thinking when the budget runs out, at most 64 tokens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo che chiude il ragionamento quando il budget finisce, al più 64 token."
          }
        }
      }
    },
    "about.thinking-token-budget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most thinking tokens of a request without its own budget; then its thinking closes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I token di ragionamento al più di una richiesta senza un suo budget; poi il ragionamento si chiude."
          }
        }
      }
    },
    "about.verify-rows": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft rows each decode cycle verifies: all checks every row so greedy and seeded outputs repeat; auto is faster."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe della bozza che ogni ciclo di decode verifica: all le verifica tutte e le uscite greedy o con seme si ripetono; auto è più veloce."
          }
        }
      }
    },
    "action.bench": {
