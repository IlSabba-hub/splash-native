    "config.observe.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe this configuration's traffic: Splash starts on the port + 10000 and the observatory proxy listens on the configuration's port, so clients stay on the same port. Requests and replies are kept in memory only, and are lost if Splash Native is closed (the port then does not answer until it reopens)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva il traffico di questa configurazione: Splash parte sulla porta + 10000 e il proxy dell'osservatorio ascolta sulla porta della configurazione, così i client restano sulla stessa porta. Richieste e risposte stanno solo in memoria; con Splash Native chiusa la porta non risponde finché non si riapre."
          }
        }
      }
    },
