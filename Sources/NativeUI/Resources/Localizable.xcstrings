    "storage.kv.about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flash-Next reads only the KV blocks its index picks, so a long request's KV can stay in the SSD cache. “Memory only” turns the cache off."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flash-Next legge solo i blocchi di KV che sceglie il suo indice: la KV delle richieste lunghe può stare nella cache SSD. «Solo in memoria» spegne la cache."
          }
        }
      }
    },
