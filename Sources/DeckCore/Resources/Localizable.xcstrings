    "error.unlimitedNeighbours %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already running without a memory limit: %@. A second server would contend for the same memory: it starts only if you confirm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già attivi senza limite di memoria: %@. Un secondo server si contenderebbe la stessa memoria: parte solo se confermi."
          }
        }
      }
    },
