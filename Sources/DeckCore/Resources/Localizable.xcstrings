{
  "sourceLanguage": "en",
  "strings": {
    "chat.failure.closedEarly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection closed before the reply ended."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione si è chiusa prima della fine della risposta."
          }
        }
      }
    },
    "chat.failure.cut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply cut: token limit reached."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta tagliata: limite di token raggiunto."
          }
        }
      }
    },
    "chat.failure.fields %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash would refuse these fields: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash rifiuterebbe questi campi: %@."
          }
        }
      }
    },
    "chat.failure.refused %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash refused the request (HTTP %1$@): %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash ha rifiutato la richiesta (HTTP %1$@): %2$@"
          }
        }
      }
    },
    "chat.failure.refusedNoMessage %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash refused the request (HTTP %@)."
          }
        },
        "it": {
