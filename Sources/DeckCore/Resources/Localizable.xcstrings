      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installer stopped unexpectedly: its log has the details."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installatore si è fermato in modo inatteso: il suo log ha i dettagli."
          }
        }
      }
    },
