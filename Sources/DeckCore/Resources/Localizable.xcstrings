          }
        }
      }
    },
    "chat.failure.server %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash stopped the reply: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash ha interrotto la risposta: %@"
          }
        }
      }
    },
    "chat.failure.tools": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools: invalid JSON (needs an array of objects)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumenti: JSON non valido (serve un array di oggetti)."
          }
        }
      }
    },
    "chat.failure.unreachable %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server does not answer: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non risponde: %@"
          }
        }
      }
    },
    "deletion.authFailed %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation failed: nothing was moved. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conferma non è riuscita: niente è stato spostato. %@"
          }
        }
      }
    },
    "deletion.authUnavailable %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID or password confirmation unavailable: nothing moved. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma con Touch ID o password non disponibile: niente spostato. %@"
          }
        }
      }
    },
    "deletion.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation cancelled: nothing was moved."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma annullata: niente è stato spostato."
          }
        }
      }
    },
    "deletion.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something changed since the check: nothing moved. Read again and retry."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è cambiato dal controllo: niente spostato. Rileggi e riprova."
          }
        }
      }
    },
    "deletion.commit %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed %1$@ together with the model %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolta %1$@ insieme al modello %2$@"
          }
        }
      }
    },
    "deletion.configurationFailed %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration %1$@ was not removed: %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione %1$@ non è stata tolta: %2$@"
          }
        }
      }
    },
    "deletion.trashFailed %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ not moved to the Trash: %2$@. Stopped here; what is already in the Trash can be put back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non spostato nel Cestino: %2$@. Mi fermo qui; ciò che è già nel Cestino si recupera."
          }
        }
      }
    },
    "download.failure.auth %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face refused access to %@: sign in with an account that can read it (hf auth login) and, if the model asks, accept its terms, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face ha rifiutato l'accesso a %@: accedi con un account che può leggerlo (hf auth login) e, se il modello lo chiede, accettane i termini, poi riprova."
          }
        }
      }
    },
    "download.failure.disk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is full. Free some space, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è pieno. Libera dello spazio, poi riprova."
          }
        }
      }
    },
    "download.failure.diskFigures %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs %1$@ of disk space, %2$@ more than is free. Free some space, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono %1$@ su disco, %2$@ più di quanto è libero. Libera dello spazio, poi riprova."
          }
        }
      }
    },
    "download.failure.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to Hugging Face dropped during the download. Check the internet connection, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione con Hugging Face si è interrotta durante il download. Controlla la connessione, poi riprova."
          }
        }
      }
    },
    "download.failure.notFound %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face has no public model named %@. Check the name, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face non ha un modello pubblico di nome %@. Controlla il nome, poi riprova."
          }
        }
      }
    },
    "download.failure.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash could not reach Hugging Face. Check the internet connection, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash non ha raggiunto Hugging Face. Controlla la connessione, poi riprova."
          }
        }
      }
    },
    "download.failure.other %@": {
      "extractionState": "manual",
      "localizations": {
