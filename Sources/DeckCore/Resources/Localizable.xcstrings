    "problem.invalidName %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid name: letters, digits, - and _ only, at most 64."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non è un nome valido: solo lettere, cifre, - e _, al massimo 64."
          }
        }
      }
    },
    "problem.invalidPort %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %@ is not allowed: 1024 to 65535, except 5000 and 7000 (AirPlay)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta %@ non è ammessa: da 1024 a 65535, escluse 5000 e 7000 (AirPlay)."
          }
        }
      }
    },
    "problem.managedFlag %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is set by Splash Deck itself."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lo imposta Splash Deck da sé."
          }
        }
      }
    },
    "problem.missingAPIModelID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model on this Mac needs the ID the API reports (--model OWNER/REPO)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello su questo Mac richiede l'ID che l'API riporta (--model OWNER/REPO)."
          }
        }
      }
    },
    "problem.noInstallation %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installation of Splash %@ on this Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna installazione di Splash %@ su questo Mac."
          }
        }
      }
    },
    "problem.notAChoice %@ %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ does not take “%2$@”; it takes %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non accetta «%2$@»; accetta %3$@."
          }
        }
      }
    },
    "problem.notAList %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ takes one value, not a list."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prende un solo valore, non una lista."
          }
        }
      }
    },
    "problem.notASwitch %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a switch: on or absent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un interruttore: acceso o assente."
          }
        }
      }
    },
    "problem.observedPort %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration is observed: Splash would listen on %@ + 10000, beyond 65535. Choose a port up to 55535."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione è osservata: Splash ascolterebbe su %@ + 10000, oltre 65535. Scegli una porta fino a 55535."
          }
        }
      }
    },
    "problem.secret %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a secret: it is kept in the Keychain, never in a configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un segreto: sta nel Portachiavi, mai in una configurazione."
          }
        }
      }
    },
    "problem.unknownFlag %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ does not exist in Splash %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non esiste in Splash %2$@."
          }
        }
      }
    },
    "removal.broken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection link leads to no installation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link di selezione non porta a nessuna installazione."
          }
        }
      }
    },
    "removal.held": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server is serving it: stop that server first."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un server la sta usando: prima ferma quel server."
          }
        }
      }
    },
    "removal.localFiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash cannot remove the preparation of local files; the files stay where they are."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash non sa togliere la preparazione di file locali; i file restano dove sono."
          }
        }
      }
    },
    "removal.optionsSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selection with its own options (draft, revision): Splash removes it only with all the model's others."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezione con opzioni proprie (bozza, revisione): Splash la toglie solo con tutte le altre del modello."
          }
        }
      }
    },
    "removal.otherUnlinked %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash's cleanup would also remove %@ other assemblies no link uses, with their files."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia di Splash toglierebbe anche altri %@ assemblaggi che nessun link usa, con i loro file."
          }
        }
      }
    },
    "removal.package": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old Splash package: Splash no longer loads it or counts it as installed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecchio pacchetto Splash: Splash non lo carica più e non lo considera installato."
          }
        }
      }
    },
    "removal.wouldFreeFiles %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash would also delete %1$@ HF cache files (%2$@) nothing else uses: Splash Deck never deletes the HF cache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Splash cancellerebbe anche %1$@ file della cache HF (%2$@) non usati da altri: Splash Deck non cancella mai la cache HF."
          }
        }
      }
    }
  },
  "version": "1.0"
}
